{
  "name": "sipa-utmach",
  "private": true,
  "version": "2.0.0",
  "description": "Portal institucional del Semillero de Investigación en Producción Animal de la Universidad Técnica de Machala.",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "npm run build && vite preview",
    "dev:expo": "vite",
    "build": "node scripts/build-sipa.mjs",
    "build:expo": "tsc && vite build --outDir dist-expo",
    "preview": "vite preview",
    "check:js": "node scripts/check-js.mjs",
    "check:site": "node scripts/validate-site.mjs",
    "test:unit": "node --test tests/unit/site-contracts.test.mjs",
    "test:e2e": "playwright test",
    "validate": "npm run check:js && npm run build && npm run check:site && npm run test:unit && npm run test:e2e",
    "qr": "node scripts/generate-qr.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "qrcode": "^1.5.4",
    "typescript": "^5.7.0",
    "vite": "^6.3.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
